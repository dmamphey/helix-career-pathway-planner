# Generated CV fixtures for the test suite. Rebuild with:
#   python tests/make_fixtures.py
tests/fixtures/

__pycache__/
*.py[cod]

# assets/vendor/ is deliberately NOT ignored. GitHub Pages serves what is in the
# repository, so the document libraries have to be committed for the deployed app
# to read a CV without contacting a third-party CDN. Fetch them with:
#   python tools/fetch_libraries.py

# Enrichment pipeline HTTP cache: rebuildable, not source.
tools/market_data/.cache/

# Vendored OCR engine and training data: ~40 MB of third-party binaries that
# tools/fetch_libraries.py reproduces exactly. Fetch them at deploy time rather
# than carrying them in every clone.
assets/vendor/tesseract*
assets/vendor/tessdata/
